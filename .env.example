# ── Database ─────────────────────────────────────────────────────────────────
# sqlite (default, zero setup) or postgres
DB_ENGINE=sqlite
SQLITE_DB_PATH=env_data.db
SQLITE_BUSY_TIMEOUT_S=30

# Only read when DB_ENGINE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=env_data
DB_USER=postgres
DB_PASSWORD=

# ── API keys ─────────────────────────────────────────────────────────────────
# WAQI feed token: https://aqicn.org/data-platform/token/
WAQI_TOKEN=your_waqi_token_here
# NASA FIRMS MAP_KEY: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here
# NOAA GFS and Open-Meteo need no key.

# ── Where the data lake lives ────────────────────────────────────────────────
DATA_DIR=./data

# ── WAQI ─────────────────────────────────────────────────────────────────────
WAQI_CITIES=delhi,mumbai,bengaluru,chennai,kolkata,hyderabad,ahmedabad,lucknow,jaipur,patna

# ── GFS ──────────────────────────────────────────────────────────────────────
# Hours to wait after a cycle's nominal time before asking NOMADS for it.
# NOAA publishes a cycle over roughly 3.5-5 hours; below ~4 you will mostly
# get HTML error pages.
GFS_PUBLICATION_LAG_HOURS=5
# Forecast lead times to download. Each adds ~14,625 rows per cycle.
GFS_FORECAST_HOURS=000,006,012,024
# 1 = full 0.25 deg grid, 2 = 0.5 deg, 4 = 1.0 deg. Raise it for a laptop demo.
GFS_GRID_STRIDE=1

# ── CAMS ─────────────────────────────────────────────────────────────────────
CAMS_GRID_STEP_DEG=2.0
CAMS_BATCH_SIZE=25

# ── Gold layer ───────────────────────────────────────────────────────────────
# Days of history each rebuild touches. Older partitions are already final.
GOLD_LOOKBACK_DAYS=3
# CPCB requires 16 of 24 hours before a daily AQI is defined.
MIN_HOURS_FOR_DAILY_AQI=16

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
